{
  "name": "genesis-firewall",
  "version": "0.0.1",
  "private": true,
  "description": "GENESIS transaction firewall — Chakravyuha pre-sign gate + community threat intel (MVP Path A)",
  "type": "module",
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "gate": "pnpm --filter @genesis/gate dev",
    "site": "pnpm --filter @genesis/site dev",
    "demo": "tsx packages/gate/src/demo.ts",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.6"
  },
  "dependencies": {
    "prettier": "^3.9.6"
  },
  "pnpm": {
    "overrides": {
      "elliptic": "^6.6.1",
      "axios@1": "^1.18.0",
      "uuid@9": "^11.1.1",
      "vite": "^6.4.3",
      "esbuild": "^0.25.0",
      "bn.js": "^5.2.3",
      "fast-xml-parser": "^5.7.0",
      "decode-uri-component": "^0.5.0"
    }
  }
}

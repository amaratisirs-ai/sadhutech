{
  "name": "genesis-firewall",
  "version": "0.0.1",
  "private": true,
  "description": "GENESIS transaction firewall — Chakravyuha pre-sign gate + community threat intel (MVP Path A)",
  "type": "module",
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "gate": "pnpm --filter @genesis/gate dev",
    "site": "pnpm --filter @genesis/site dev",
    "demo": "tsx packages/gate/src/demo.ts",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "prettier": "^3.9.6"
  },
  "pnpm": {
    "overrides": {
      "@noble/curves@1": "2.3.0",
      "@walletconnect/logger>pino": "10.1.1",
      "axios@1": "1.18.0",
      "immer@9": "11.1.9",
      "uuid@9": "11.1.1",
      "ws@8": "8.21.1",
      "zod@3": "4.4.0"
    }
  }
}
